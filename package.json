{
  "name": "nudge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @nudge/web",
    "build": "npm run build -w @nudge/web",
    "start": "npm run start -w @nudge/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "rolldown": "1.2.1"
  }
}
