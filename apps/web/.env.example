# Supabase settings for the website. Copy this file to .env.local (same folder)
# and fill in the two values from the Supabase project: Project Settings > API Keys.
#
# Both values are public by design: the publishable key can do no more than the
# database's row level security and functions allow. Never put a secret key
# (sb_secret_... or service_role) in this app or in any committed file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
