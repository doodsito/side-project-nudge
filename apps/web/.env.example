# Supabase settings for the website. Copy this file to .env.local (same folder)
# and fill in the two values from the Supabase project: Project Settings > API Keys.
#
# Both values are public by design: the publishable key can do no more than the
# database's row level security and functions allow. Never put a secret key
# (sb_secret_... or service_role) in this app or in any committed file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog analytics (loaded only after the visitor accepts analytics cookies).
# Both values are public: PostHog > Project settings > Project token and host.
# Leave empty locally to keep PostHog off.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# World 2 V2 only: set both to true solely on a deployment connected to an
# isolated Supabase project. Keep blank for beta and for local read-only preview.
V2_LESSONS_ENABLED=
V2_DATA_ISOLATED=
